{
  "$schema": "https://angular.io/cli/schema.json",
  "version": 1,
  "projects": {
    "angular-file-manager": {
      "projectType": "application",
      "root": "src",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/angular-file-manager",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.json",
            "assets": ["src/assets"],
            "styles": ["src/styles.css"]
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "angular-file-manager:build"
          }
        }
      }
    }
  },
  "defaultProject": "angular-file-manager",
  "cli": {
    "analytics": false
  }
}
